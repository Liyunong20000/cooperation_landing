Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Plane Cell Count: 30
      Cell Size: 0.5
      Alpha: 0.5
    - Class: rviz/RobotModel
      Name: Spot + Kortex
      Enabled: true
      Robot Description: robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz/TF
      Name: TF
      Enabled: false
      Frame Timeout: 15
      Marker Alpha: 1
      Marker Scale: 0.3
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 4.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0.5
      Pitch: 0.45
      Yaw: 0.8
      Target Frame: body
Window Geometry:
  Height: 900
  Width: 1400
