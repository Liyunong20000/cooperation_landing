<?xml version="1.0"?>

<robot name="simulation_environment_cube12" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="cube_put">
    <inertial>
      <mass value = "0.1" />
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
          ixx="0.000001" ixy="0" ixz="0"
          iyy="0.000001" iyz="0"
          izz="0.000001"/>
    </inertial>
    <visual>
      <origin rpy="${pi/2} 0 0" xyz="0 0.6 0.15"/>
      <geometry>
        <mesh filename="package://cooperation_landing/urdf/mesh/cube_0.3_0.3_1.2.dae" />
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 ${pi/2}" xyz="0 0 0.1"/>
      <geometry>
        <box size="1.2 0.3 0.5"/>
      </geometry>
    </collision>
  </link>

  <joint name="apriltag_12_joint" type="fixed">
    <parent link="cube_put"/>
    <child link="apriltag_12"/>
    <origin xyz="-0.15 0 0.15" rpy="${pi/2} 0 ${-pi/2}" />
    <axis xyz="0 0 1"/>
  </joint>

  <link name="apriltag_12">
    <inertial>
      <mass value = "0.001" />
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
          ixx="0.000001" ixy="0" ixz="0"
          iyy="0.000001" iyz="0"
          izz="0.000001"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://cooperation_landing/urdf/mesh/apriltag_12_0.3.dae" />
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

</robot>
