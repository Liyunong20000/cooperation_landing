<?xml version="1.0"?>
<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro" name="xuanwu_tags" >

  <!-- robot urdf -->
  <xacro:include filename="$(find xuanwu)/urdf/robot.urdf.xacro" />

  <!-- <!-\- additional model -\-> -->
  <joint name="apriltag_0_joint" type="fixed">
    <parent link="main_body"/>
    <child link="apriltag_0"/>
    <origin rpy="${pi/2} 0 0" xyz="0.04779 0 -0.077"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="apriltag_0">
    <inertial>
      <mass value = "0.001" />
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
          ixx="0.000001" ixy="0" ixz="0"
          iyy="0.000001" iyz="0"
          izz="0.000001"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://cooperation_landing/urdf/mesh/apriltag_0_0.0195.dae" />
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

</robot>
