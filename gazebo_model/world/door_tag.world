<?xml version="1.0" ?>
<sdf version='1.6'>
  <world name='door_tag'>

    <physics type='ode'>
      <max_step_size>0.0002</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>5000</real_time_update_rate>
      <gravity>0 0 -9.81</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>10.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <plugin name="ros_link_attacher_plugin" filename="libgazebo_ros_link_attacher.so"/>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
    </scene>

    <light name='sun_no_shadow' type='directional'>
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name='hinged_door_with_tag'>
      <pose>0.50 0.03 0 0 0 3.14159</pose>
      <static>false</static>

      <link name='door_frame'>
        <pose>0 0 0.45 0 0 0</pose>
        <inertial>
          <mass>1000.0</mass>
          <inertia>
            <ixx>100.0</ixx>
            <iyy>100.0</iyy>
            <izz>100.0</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>

        <collision name='left_post_collision'>
          <pose>0 -0.48 0 0 0 0</pose>
          <geometry><box><size>0.08 0.08 0.90</size></box></geometry>
        </collision>
        <visual name='left_post_visual'>
          <pose>0 -0.48 0 0 0 0</pose>
          <geometry><box><size>0.08 0.08 0.90</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>

        <collision name='right_post_collision'>
          <pose>0 0.48 0 0 0 0</pose>
          <geometry><box><size>0.08 0.08 0.90</size></box></geometry>
        </collision>
        <visual name='right_post_visual'>
          <pose>0 0.48 0 0 0 0</pose>
          <geometry><box><size>0.08 0.08 0.90</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>

        <collision name='top_bar_collision'>
          <pose>0 0 0.43 0 0 0</pose>
          <geometry><box><size>0.08 0.86 0.08</size></box></geometry>
        </collision>
        <visual name='top_bar_visual'>
          <pose>0 0 0.43 0 0 0</pose>
          <geometry><box><size>0.08 0.86 0.08</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>

      <link name='door_panel'>
        <pose>0 -0.35 0.45 0 0 0</pose>
        <inertial>
          <pose>0 0.35 0 0 0 0</pose>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.167</ixx>
            <iyy>0.003</iyy>
            <izz>0.107</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>

        <collision name='panel_collision'>
          <pose>0 0.35 0 0 0 0</pose>
          <geometry><box><size>0.04 0.70 0.80</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name='panel_visual'>
          <pose>0 0.35 0 0 0 0</pose>
          <geometry><box><size>0.04 0.70 0.80</size></box></geometry>
          <material><ambient>0.55 0.36 0.20 1</ambient><diffuse>0.55 0.36 0.20 1</diffuse></material>
        </visual>

        <visual name='door_tag_visual'>
          <pose>-0.026 0.35 0.18 0 1.5708 0</pose>
          <geometry><box><size>0.002 0.18 0.18</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>

      <link name='door_handle'>
        <pose>0.07 0.23 0.50 0 1.5708 0</pose>
        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>0.00018</ixx>
            <iyy>0.00004</iyy>
            <izz>0.00019</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>
        <collision name='handle_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.06 0.16 0.04</size></box></geometry>
        </collision>
        <visual name='handle_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.06 0.16 0.04</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
      </link>

      <joint name='frame_to_world' type='fixed'>
        <parent>world</parent>
        <child>door_frame</child>
      </joint>

      <joint name='door_hinge' type='revolute'>
        <parent>door_frame</parent>
        <child>door_panel</child>
        <pose>0 0 0 0 0 0</pose>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-0.10</lower>
            <upper>2.60</upper>
            <effort>20.0</effort>
            <velocity>4.0</velocity>
          </limit>
          <dynamics>
            <damping>1.4</damping>
            <friction>0.2</friction>
          </dynamics>
        </axis>
      </joint>

      <joint name='handle_hinge' type='revolute'>
        <parent>door_panel</parent>
        <child>door_handle</child>
        <pose>0 0 0 0 0 0</pose>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1.5708</lower>
            <upper>1.5708</upper>
            <effort>2.0</effort>
            <velocity>4.0</velocity>
          </limit>
          <dynamics>
            <damping>0.01</damping>
            <friction>0.0</friction>
          </dynamics>
        </axis>
      </joint>
    </model>

  </world>
</sdf>
