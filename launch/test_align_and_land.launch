<!--   <node pkg="cooperation_landing" type="AprillandQilin.py" name="align_dog_drone" output="screen" respawn="false"> -->
<!--     <param name="demo_target_index" value="$(arg demo_target_index)" /> -->
<!--   </node> -->
</launch>
