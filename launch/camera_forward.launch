<?xml version="1.0" encoding="utf-8"?>
<launch>
  <arg name="robot_ns" default="qilin" />
  <arg name="camera_ns" default="qilin" />

  <group ns="$(arg robot_ns)">
    <!-- USB camera -->
    <node name="usb_camera_forward" pkg="usb_cam" type="usb_cam_node" output="screen" >
<!--       <param name="video_device" value="/dev/dragon_qilin_camera_upward" /> -->
      <param name="video_device" value="/dev/video0" />
      <param name="image_width" value="1280" />
      <param name="image_height" value="720" />
      <param name="pixel_format" value="yuyv" />
      <param name="color_format" value="yuv422p" />
      <param name="camera_frame_id" value="usb_camera_forward" />
      <param name="io_method" value="mmap"/>
      <param name="camera_info_url" value="file://$(find cooperation_landing)/config/camera_info/ELP-L100/720P/calibrationdata/ost.yaml" />
    </node>

    <node name="forward_image_proc" pkg="image_proc" type="image_proc" output="screen">
      <remap from="image_raw" to="/$(arg robot_ns)/usb_camera_upward/image_raw"/>
      <remap from="camera_info" to="/$(arg robot_ns)/usb_camera_upward/camera_info"/>
      <remap from="image_rect_color" to="/$(arg robot_ns)/usb_camera_upward/image_rect_color" />
    </node>

  <!-- Apriltag detection -->
    <include file="$(find apriltag_ros)/launch/continuous_detection.launch">
      <arg name="camera_name" value="/$(arg robot_ns)/usb_camera_upward" />
      <arg name="image_topic" value="image_rect_color" />
    </include>
    <rosparam command="load" file="$(find cooperation_landing)/config/apriltag/tags.yaml" ns="/apriltag_ros_continuous_node"/>

    <node name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
      <remap from="image" to="usb_camera_upward/image_raw"/>
      <param name="autosize" value="true" />
    </node>

  <!-- Mocap -->
    <include file="$(find cooperation_landing)/launch/mocap.launch">
      <arg name="robot_id" default="2"/>
    </include>
  </group>
</launch>
