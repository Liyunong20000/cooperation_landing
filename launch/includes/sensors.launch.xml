<?xml version="1.0"?>
<launch>
  <arg name="real_machine" default="false" />
  <arg name="simulation" default="false" />
  <arg name="robot_ns" default="unitree_go1" />

  <group if="$(arg real_machine)">
    <group unless="$(arg simulation)">
      <!-- USB camera and AprilTag detector. -->
      <include file="$(find cooperation_landing)/launch/camera_mocap/ground_camera_apriltag.launch">
        <arg name="robot_ns" value="$(arg robot_ns)" />
      </include>
    </group>
  </group>

</launch>
