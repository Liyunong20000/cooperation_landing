<launch>

  <arg name="robot_id" default="1"/>

  <node pkg="mocap_optitrack"
    type="mocap_node"
    name="mocap_node"
    respawn="false"
    launch-prefix=""
    required="true">
    <rosparam subst_value="true">
      rigid_bodies:
         '$(arg robot_id)':
               pose: ground_robot/mocap/pose
               pose2d: ground_robot/mocap/ground_pose
               child_frame_id: baselink
               parent_frame_id: world
         '3':
               pose: brick/mocap/pose
               pose2d: brick/mocap/ground_pose
               child_frame_id: baselink
               parent_frame_id: world
         '4':
               pose: desk/mocap/pose
               pose2d: desk/mocap/ground_pose
               child_frame_id: baselink
               parent_frame_id: world
         '5':
               pose: tag12/mocap/pose
               pose2d: tag12/mocap/ground_pose
               child_frame_id: baselink
               parent_frame_id: world
         '6':
               pose: tag13/mocap/pose
               pose2d: tag13/mocap/ground_pose
               child_frame_id: baselink
               parent_frame_id: world
      optitrack_config:
         enable_optitrack: true 
         multicast_address: 239.255.42.99
         command_port: 1510
         data_port: 1511
    </rosparam>
    <remap from="~mocap/pose" to="mocap/pose" />
  </node>

</launch>
