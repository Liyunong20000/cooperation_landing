<?xml version="1.0" encoding="utf-8"?>
<launch>
<arg name="input_camera_name" default="/usb_cam" />
<arg name="scale" default="1.0" />
<arg name="calib_path" default="$(find cooperation_landing)/config/camera_info/ELP-L180/720P/kalibr/1/kalibr_ost.yaml"/>

  <rosparam command="load" file="$(find cooperation_landing)/config/camera_info/ELP-L180/720P/kalibr/1/kalibr_ost.yaml"/>
  <node name="image_undistort_node" pkg="image_undistort" type="image_undistort_node">
    <param name="input_camera_namespace" value="$(arg input_camera_name)"/>
    <param name="input_camera_info_from_ros_params" value = "true"/>
    <param name="scale" value="$(arg scale)"/>
    <param name="output_camera_info_source" value="auto_generated"/>
<!--     <rosparam file="$(arg calib_path)"/> -->
    <remap from="input/image" to="$(arg input_camera_name)/image_raw"/>
  </node>
</launch>
