<?xml version="1.0"?>
<launch>
  <arg name="world_name" default="$(find spot_config)/worlds/default.world"/>
  <arg name="gui" default="true"/>
  <arg name="paused" default="true"/>
  <arg name="auto_unpause" default="true"/>
  <arg name="start_rviz" default="true"/>
  <arg name="rviz_config" default="$(find cooperation_landing)/config/robot/spot_kortex_gazebo.rviz"/>

  <arg name="model_name" default="spot_kortex"/>
  <arg name="world_init_x" default="0.0"/>
  <arg name="world_init_y" default="0.0"/>
  <!-- Nominal body height is about 0.48 m: 0.68 m gives a 0.20 m drop. -->
  <arg name="world_init_z" default="0.68"/>
  <arg name="world_init_heading" default="0.0"/>

  <arg name="vision" default="true"/>
  <arg name="with_gripper" default="true"/>
  <arg name="arm_prefix" default="arm_"/>
  <arg name="mount_xyz" default="0 0 0.105"/>
  <arg name="mount_rpy" default="0 0 0"/>

  <arg name="start_champ" default="true"/>
  <arg name="start_state_estimation" default="true"/>
  <arg name="controller_timeout" default="45.0"/>
  <arg name="spawn_configuration_delay" default="1.5"/>
  <arg name="gravity_ramp_steps" default="10"/>
  <arg name="gravity_ramp_step_duration" default="0.1"/>

  <param name="use_sim_time" value="true"/>
  <param name="robot_description"
         command="$(find xacro)/xacro $(find cooperation_landing)/urdf/spot_kortex.urdf.xacro
                  simulation:=true
                  vision:=$(arg vision)
                  with_gripper:=$(arg with_gripper)
                  arm_prefix:=$(arg arm_prefix)
                  mount_xyz:='$(arg mount_xyz)'
                  mount_rpy:='$(arg mount_rpy)'"/>

  <!-- CHAMP parameters for the Spot half of the combined model. -->
  <rosparam command="load" ns="gait" file="$(find spot_config)/config/gait/gait.yaml"/>
  <rosparam command="load" ns="links_map" file="$(find spot_config)/config/links/links.yaml"/>
  <rosparam command="load" ns="joints_map" file="$(find spot_config)/config/joints/joints.yaml"/>

  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"
        output="screen">
    <param name="use_tf_static" value="false"/>
    <param name="publish_frequency" value="100"/>
    <param name="ignore_timestamp" value="true"/>
  </node>

  <group if="$(arg start_champ)">
    <include file="$(find champ_bringup)/launch/include/velocity_smoother.launch"/>

    <node name="champ_controller" pkg="champ_base" type="quadruped_controller_node" output="screen">
      <param name="gazebo" value="true"/>
      <param name="publish_joint_states" value="false"/>
      <param name="publish_foot_contacts" value="false"/>
      <param name="publish_joint_control" value="true"/>
      <param name="joint_controller_topic" value="joint_group_position_controller/command"/>
    </node>

    <node name="state_estimator" pkg="champ_base" type="state_estimation_node" output="screen"
          if="$(arg start_state_estimation)">
      <param name="orientation_from_imu" value="true"/>
    </node>

    <node name="base_to_footprint_ekf" pkg="robot_localization" type="ekf_localization_node"
          if="$(arg start_state_estimation)">
      <remap from="odometry/filtered" to="odom/local"/>
      <param name="base_link_frame" value="body"/>
      <rosparam command="load" file="$(find champ_base)/config/ekf/base_to_footprint.yaml"/>
    </node>

    <node name="footprint_to_odom_ekf" pkg="robot_localization" type="ekf_localization_node"
          if="$(arg start_state_estimation)">
      <remap from="odometry/filtered" to="odom"/>
      <rosparam command="load" file="$(find champ_base)/config/ekf/footprint_to_odom.yaml"/>
    </node>
  </group>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="true"/>
  </include>

  <!--
    Start close to a stable crouched stance instead of the invalid zero-knee
    configuration. This greatly reduces the spawn impulse that flips Spot.
  -->
  <node name="spot_kortex_spawner" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-urdf -param robot_description -model $(arg model_name)
              -x $(arg world_init_x) -y $(arg world_init_y) -z $(arg world_init_z)
              -Y $(arg world_init_heading) -robot_namespace /
              -J front_left_hip_x 0.0 -J front_left_hip_y 1.05473 -J front_left_knee -1.67952
              -J front_right_hip_x 0.0 -J front_right_hip_y 1.05473 -J front_right_knee -1.67952
              -J rear_left_hip_x 0.0 -J rear_left_hip_y 1.05473 -J rear_left_knee -1.67952
              -J rear_right_hip_x 0.0 -J rear_right_hip_y 1.05473 -J rear_right_knee -1.67952
              -J $(arg arm_prefix)joint_1 1.57
              -J $(arg arm_prefix)joint_2 -0.35
              -J $(arg arm_prefix)joint_3 3.14
              -J $(arg arm_prefix)joint_4 -2.00
              -J $(arg arm_prefix)joint_5 0.0
              -J $(arg arm_prefix)joint_6 -1.00
              -J $(arg arm_prefix)joint_7 1.57"/>

  <rosparam command="load" file="$(find cooperation_landing)/config/spot_kortex_controllers.yaml"/>

  <node name="spot_kortex_controller_spawner" pkg="controller_manager" type="spawner"
        output="screen"
        args="joint_states_controller joint_group_position_controller arm_gen3_joint_trajectory_controller"/>

  <node name="spot_kortex_gripper_controller_spawner" pkg="controller_manager" type="spawner"
        output="screen" if="$(arg with_gripper)"
        args="arm_robotiq_2f_85_gripper_controller"/>

  <node name="contact_sensor" pkg="champ_gazebo" type="contact_sensor" output="screen"
        if="$(arg start_state_estimation)"/>

  <!-- ros_control needs Gazebo updates to finish initializing trajectory controllers. -->
  <group if="$(arg auto_unpause)">
    <node name="spot_kortex_unpause" pkg="cooperation_landing" type="wait_for_controllers_and_unpause.py"
          output="screen" if="$(arg with_gripper)">
      <param name="timeout" value="$(arg controller_timeout)"/>
      <param name="spawn_configuration_delay" value="$(arg spawn_configuration_delay)"/>
      <param name="gravity_ramp_steps" value="$(arg gravity_ramp_steps)"/>
      <param name="gravity_ramp_step_duration" value="$(arg gravity_ramp_step_duration)"/>
      <rosparam param="required_controllers">
        [joint_states_controller, joint_group_position_controller,
         arm_gen3_joint_trajectory_controller, arm_robotiq_2f_85_gripper_controller]
      </rosparam>
    </node>

    <node name="spot_kortex_unpause" pkg="cooperation_landing" type="wait_for_controllers_and_unpause.py"
          output="screen" unless="$(arg with_gripper)">
      <param name="timeout" value="$(arg controller_timeout)"/>
      <param name="spawn_configuration_delay" value="$(arg spawn_configuration_delay)"/>
      <param name="gravity_ramp_steps" value="$(arg gravity_ramp_steps)"/>
      <param name="gravity_ramp_step_duration" value="$(arg gravity_ramp_step_duration)"/>
      <rosparam param="required_controllers">
        [joint_states_controller, joint_group_position_controller,
         arm_gen3_joint_trajectory_controller]
      </rosparam>
    </node>
  </group>

  <node name="rviz" pkg="rviz" type="rviz" args="-d $(arg rviz_config)"
        if="$(arg start_rviz)"/>
</launch>
