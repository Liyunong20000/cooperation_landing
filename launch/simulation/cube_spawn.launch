<launch>
    <arg name="cube_ns" default="cube_pick" />
    <arg name="cube_model" />
    <arg name="cube_x" default="2.5" />
    <arg name="cube_y" default="2.5" />
    <arg name="cube_z" default="0.0" />


    <group ns="$(arg cube_ns)">
          <!-- Load the URDF into the ROS Parameter Server -->
      <param name="robot_description" command="$(find xacro)/xacro $(arg cube_model) robot_name:=$(arg cube_ns)"/>
      <node name="$(anon robot_state_publisher)" pkg="robot_state_publisher" type="robot_state_publisher">
        <param name="tf_prefix" value="$(arg cube_ns)" />
      </node>
    </group>
    <node pkg="gazebo_ros" type="spawn_model" name="$(anon urdf_spawner)" respawn="false" output="screen" args="-urdf -model $(arg cube_ns) -x $(arg cube_x) -y $(arg cube_y) -z $(arg cube_z) -param $(arg cube_ns)/robot_description -unpause" />

</launch>
