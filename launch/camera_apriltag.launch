<?xml version="1.0" encoding="utf-8"?>
<launch>
  <arg name="robot_ns" default="qilin" />
  <arg name="camera_ns" default="usb_cam_upward" />

  <group ns="$(arg robot_ns)">
    <group ns="$(arg camera_ns)">
      <!-- USB camera -->
      <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen" >
        <param name="video_device" value="/dev/$(arg robot_ns)_$(arg camera_ns)" />
<!--         <param name="video_device" value="/dev/video0" /> -->
        <param name="image_width" value="1280" />
        <param name="image_height" value="720" />
        <param name="pixel_format" value="yuyv" />
        <param name="color_format" value="yuv422p" />
        <param name="camera_frame_id" value="usb_cam" />
        <param name="io_method" value="mmap"/>
        <param name="camera_info_url" value="file://$(find cooperation_landing)/config/camera_info/$(arg camera_ns)/720p/calibrationdata/ost.yaml" />
      </node>

      <node name="image_proc" pkg="image_proc" type="image_proc" output="screen">
        <remap from="image_raw" to="/$(arg robot_ns)/$(arg camera_ns)/usb_cam/image_raw"/>
        <remap from="camera_info" to="/$(arg robot_ns)/$(arg camera_ns)/usb_cam/camera_info"/>
        <remap from="image_rect_color" to="/$(arg robot_ns)/$(arg camera_ns)/usb_cam/image_rect_color" />
      </node>
    </group>
  </group>
<!--         Apriltag detection -->
  <include file="$(find apriltag_ros)/launch/continuous_detection.launch">
    <arg name="camera_name" value="/$(arg robot_ns)/$(arg camera_ns)/usb_cam" />
    <arg name="image_topic" value="image_rect_color" />
    <arg name="node_namespace" default="$(arg robot_ns)_$(arg camera_ns)_apriltag_ros_continuous_node" />
  </include>
  <rosparam command="load" file="$(find cooperation_landing)/config/apriltag/$(arg camera_ns)/tags.yaml" ns="$(arg robot_ns)_$(arg camera_ns)_apriltag_ros_continuous_node"/>

<!--     <node name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen"> -->
<!--       <remap from="image" to="$(arg camera_ns)/image_rect_color"/> -->
<!--       <param name="autosize" value="true" /> -->
<!--     </node> -->

</launch>
